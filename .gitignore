# ----- General build artefacts -----
# Object / binary files
*.o
*.a
*.so
*.dll
*.dylib
*.exe
*.out
*.class
*.com

# Packaging
*.jar
*.war
*.ear
*.zip
*.tar
*.gz
*.7z
*.rar
*.iso

# ----- Logs & databases -----
*.log
*.sql
*.sqlite*
*.db

# ----- Temporary & editor swap files -----
*~
.*.swp
.*.swo
*.tmp
*.temp
*.bak
.DS_Store
**/.DS_Store

# ----- Python -----
__pycache__/
*.py[cod]
.pytest_cache/
.flake8
.*y_cache/

# ----- Virtual / local envs -----
.venv/
.env
.pyenv

# ----- IDE / tooling configs -----
.vscode/
.idea/
.zed/
ext/**/.github/
.clangd

# ----- Version control helpers -----
# cscope
cscope.*
# Parser tables generated by PLY
parser.out
parsetab.py

# ----- Build / output directories -----
build/
checkpoints/
dist/
results/
smoke_results/
# gem5 run output
m5out/
m5out_*/
mount_target/
# Custom profiling / result folders
result_size_4096/
mount/*_tmp.conf
mount/pf_config.json
mount/visual/plots/
mount/sanitizer/output
mount/*.txt
mount/**/*.txt

# ----- gem5-specific third-party build trees -----
/src/doxygen/html/
/ext/dramsim2/DRAMSim2/

# ----- gem5 util build artefacts -----
/util/m5/*.o
/util/m5/*.a
/util/m5/m5
/util/packet_pb2.py
/util/tap/*.d
/util/tap/*.o
/util/tap/m5tap
/util/term/m5term

# ----- ARM platform blobs -----
/system/arm/dt/*.dtb
/system/arm/dt/.gen/
/system/arm/bootloader/arm/*.o
/system/arm/bootloader/arm/boot.arm
/system/arm/bootloader/arm/boot_emm.arm
/system/arm/bootloader/arm64/*.o
/system/arm/bootloader/arm64/boot.arm64
/system/arm/bootloader/arm64/boot_emm.arm64
/system/arm/bootloader/arm64/boot_v2.arm64

# ----- Debug output folders -----
DEBUG_*/**/*.log
DEBUG_LDP/
DEBUG_Cache/
DEBUG_HWPrefetch/
local/
